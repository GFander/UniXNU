diff --git a/osfmk/arm64/kebab_early.c b/osfmk/arm64/kebab_early.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/kebab_early.c
@@ -0,0 +1,240 @@
+/*
+ * OnePlus 10 Pro 5G bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * This file maps the splash framebuffer itself (see kebab_fb_map), because the
+ * bootstrap V=P tables only cover the kernel window and the framebuffer at
+ * 0x9C000000 lives in a different L1 slot.
+ * Stop using that mapping before arm_vm_init tears down bootstrap TTBR0.
+ */
+#include <arm64/kebab_early.h>
+
+#if 1 /* kebab early console */
+#include <stdint.h>
+#include <kern/misc_protos.h>
+#include <arm64/proc_reg.h>
+
+#define EARLY_FB ((volatile uint32_t *)(uintptr_t)0x9c000000)
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2400u
+#define EARLY_STRIDE (4320u / 4)
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+_Static_assert(ARM_PGBYTES == 4096, "early framebuffer requires a 4K granule");
+_Static_assert(ARM_TT_L2_SIZE == 0x200000ULL, "early framebuffer uses 2M L2 blocks");
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_mapped;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+kebab_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+/*
+ * Map the splash framebuffer at 0x9C000000 with the bootstrap page tables.
+ *
+ * The 4 KiB bootstrap V=P mapping only creates L2 tables for the kernel
+ * window, which lives in L1 slot 3; the framebuffer is in slot 2, so its L1
+ * entry is empty.  Point it at a private L2 page and add one 2 MiB Normal
+ * Non-Cacheable block.  Both the table and the code run from the V=P window,
+ * so the virtual address of the table is its physical address.
+ */
+extern uint8_t bootstrap_pagetables[];
+
+static uint64_t kebab_fb_l2[TTE_PGENTRIES] __attribute__((aligned(ARM_PGBYTES)));
+
+/*
+ * Map the splash framebuffer into the bootstrap translation.
+ *
+ * The hardware walks the tables with PHYSICAL addresses, while this code
+ * reaches the tables through the kernel's virtual mapping, so the descriptor
+ * must convert the L2 page's VA to a PA first.  The framebuffer is 10.37 MB,
+ * which is five 2 MiB blocks, not one.
+ *
+ * The mapping is only installed when the bootstrap root is the active TTBR0
+ * and L1[2] is completely empty; anything unexpected is refused so a wrong
+ * assumption cannot corrupt live translations.
+ */
+static bool
+kebab_fb_map(uint64_t virt_base, uint64_t phys_base)
+{
+	uint64_t           fb = (uint64_t)EARLY_FB;
+	volatile uint64_t *l1 = (volatile uint64_t *)(void *)bootstrap_pagetables;
+	volatile uint64_t *l2 = (volatile uint64_t *)kebab_fb_l2;
+	uint64_t           root_pa = (uint64_t)(uintptr_t)l1 - virt_base + phys_base;
+	uint64_t           l2_pa = (uint64_t)(uintptr_t)l2 - virt_base + phys_base;
+	uint64_t           ttbr0;
+	uint64_t           flags;
+	uint32_t           i1, i2, i;
+
+	__asm__ volatile("mrs %0, ttbr0_el1" : "=r"(ttbr0));
+
+	if (((root_pa | l2_pa) & (ARM_PGBYTES - 1)) != 0) {
+		return false;
+	}
+	if ((ttbr0 & ARM_TTE_TABLE_MASK) != root_pa) {
+		return false;   /* not running on the bootstrap root */
+	}
+
+	if ((fb & (ARM_TT_L2_SIZE - 1ULL)) != 0) {
+		return false;   /* not 2 MiB aligned */
+	}
+
+	i1 = (uint32_t)((fb & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
+	i2 = (uint32_t)((fb & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+
+	if (i2 + 5u > TTE_PGENTRIES) {
+		return false;   /* five blocks do not fit in one L2 table */
+	}
+
+	if (l1[i1] != ARM_TTE_EMPTY) {
+		return false;   /* never replace a live descriptor */
+	}
+
+	for (i = 0; i < TTE_PGENTRIES; i++) {
+		l2[i] = ARM_TTE_EMPTY;
+	}
+
+	flags = ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+
+	for (i = 0; i < 5; i++) {
+		l2[i2 + i] = ((fb + (uint64_t)i * ARM_TT_L2_SIZE) &
+		    ARM_TTE_BLOCK_L2_MASK) | flags;
+	}
+
+	/* Fill the children before publishing the parent. */
+	__asm__ volatile("dsb sy" ::: "memory");
+	l1[i1] = (l2_pa & ARM_TTE_TABLE_MASK) | ARM_TTE_BOOT_TABLE;
+	__asm__ volatile(
+		"dsb sy\n"
+		"tlbi vmalle1\n"
+		"dsb sy\n"
+		"isb\n" ::: "memory");
+
+	return true;
+}
+
+void
+kebab_early_init(void *boot_args_ptr)
+{
+	boot_args *ba = (boot_args *)boot_args_ptr;
+
+	early_mapped = kebab_fb_map(ba->virtBase, ba->physBase) ? 1 : 0;
+}
+
+void
+kebab_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		kebab_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		kebab_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned int)(unsigned char)c * 16u;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+kebab_early_string(const char *s)
+{
+	while (*s) {
+		kebab_early_putc(*s++);
+	}
+}
+
+void
+kebab_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 8) {
+		return;
+	}
+	if (!early_mapped) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	kebab_early_string("KEBAB EARLY ");
+	kebab_early_putc((char)('0' + stage));
+	kebab_early_string(": ");
+	kebab_early_string(label);
+	kebab_early_putc('\n');
+	/* self-disable: stage 7 is the last mark before arm_vm_init replaces TTBR0,
+	 * so no separate hook is needed in arm_vm_init.c. */
+	if (stage >= 7) {
+		early_disabled = 1;
+	}
+}
+
+void
+kebab_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	kebab_early_string("\nKEBAB EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, kebab_early_putc, 16);
+	va_end(copy);
+	kebab_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+kebab_early_disable(void)
+{
+	kebab_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* KEBAB */
diff --git a/osfmk/arm64/kebab_early.h b/osfmk/arm64/kebab_early.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/kebab_early.h
@@ -0,0 +1,24 @@
+/* Early screen diagnostics, valid only while the bootstrap TTBR0 is live. */
+#ifndef _ARM64_NEGRONI_EARLY_H_
+#define _ARM64_NEGRONI_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <pexpert/boot.h>
+#include <stdarg.h>
+
+#if 1 /* kebab early console */
+void kebab_early_init(void *boot_args_ptr);
+void kebab_early_mark(unsigned int stage, const char *label);
+void kebab_early_putc(char c);
+void kebab_early_panic(const char *fmt, va_list *args);
+void kebab_early_disable(void);
+#else
+static inline void kebab_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void kebab_early_disable(void) {}
+#endif
+
+#endif
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -76,6 +76,7 @@
 #include <sys/kdebug.h>
 
 #include <pexpert/pexpert.h>
+#include <arm64/kebab_early.h>
 
 #include <console/serial_protos.h>
 
@@ -357,6 +358,8 @@
 	arm_setup_pre_sign();
 
 	arm_slide_rebase_and_sign_image();
+	kebab_early_init(args);
+	kebab_early_mark(1, "arm_init image fixups done");
 
 	/* If kernel integrity is supported, use a constant copy of the boot args. */
 	const_boot_args = *args;
@@ -442,6 +445,7 @@
 #endif
 
 	ml_parse_cpu_topology();
+	kebab_early_mark(3, "ml_parse_cpu_topology done");
 
 
 	master_cpu = ml_get_boot_cpu_number();
@@ -471,11 +475,13 @@
 	 */
 	thread->machine.preemption_count = 0;
 	cpu_bootstrap();
+	kebab_early_mark(4, "cpu_bootstrap done");
 
 	rtclock_early_init();
 
 	kernel_debug_string_early("kernel_startup_bootstrap");
 	kernel_startup_bootstrap();
+	kebab_early_mark(5, "kernel_startup_bootstrap done");
 
 	/*
 	 * Initialize the timer callout world
@@ -483,6 +489,7 @@
 	timer_call_init();
 
 	cpu_init();
+	kebab_early_mark(6, "cpu_init done");
 
 	processor_bootstrap();
 
@@ -532,6 +539,7 @@
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
 	boot_progress_stage("arm_vm_init enter");
+	kebab_early_mark(7, "entering arm_vm_init");
 	arm_vm_init(xmaxmem, args);
 	boot_progress_stage("arm_vm_init returned");
 
diff --git a/osfmk/conf/files.arm64 b/osfmk/conf/files.arm64
--- a/osfmk/conf/files.arm64
+++ b/osfmk/conf/files.arm64
@@ -51,6 +51,7 @@
 osfmk/arm/arm_timer.c		standard
 osfmk/arm/arm_init.c	optional config_pmap_ppl
 osfmk/arm64/arm_vm_init.c	optional config_pmap_ppl
+osfmk/arm64/kebab_early.c	standard
 osfmk/arm64/arm64_hypercall.c	standard
 osfmk/arm/io_map.c		standard
 osfmk/arm64/loose_ends.c	standard
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -84,6 +84,9 @@
 #include <stdatomic.h>
 #include <sys/pgo.h>
 #include <console/serial_protos.h>
+#if defined(__arm64__)
+#include <arm64/kebab_early.h>
+#endif
 #include <IOKit/IOBSD.h>
 
 #if !(MACH_KDP && CONFIG_KDP_INTERACTIVE_DEBUGGING)
